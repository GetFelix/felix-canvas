# Overrides .env for the Dex example in dex.yaml.
COMPOSE_PROFILES=
CANVAS_OIDC_ISSUER=http://127.0.0.1:5556/dex
CANVAS_OIDC_JWKS_URL=http://dex:5556/dex/keys
CANVAS_OIDC_CLIENT_ID=felix-canvas
CANVAS_OIDC_SCOPES=openid profile email
# Dex's sub claim is opaque, so members are named by email.
CANVAS_OIDC_SUBJECT_CLAIM=email
CANVAS_ROOMS=lobby=ana@example.com,ben@example.com studio=ana@example.com

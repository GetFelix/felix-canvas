# Settings for docker-compose.yml. docs/self-hosting.md describes each one.

# Change both before the first start. The bootstrap token can create tenants
# and cluster credentials; the Postgres password guards the Felix metadata.
FELIX_BOOTSTRAP_TOKEN=change-me
POSTGRES_PASSWORD=change-me

# Where browsers reach the canvas.
CANVAS_BIND=127.0.0.1
CANVAS_PORT=8787

# The identity provider browsers sign in with. These point at the
# development sign-in page, which signs in anyone; replace them with your
# provider's and remove dev-idp from COMPOSE_PROFILES.
COMPOSE_PROFILES=dev-idp
CANVAS_OIDC_ISSUER=http://127.0.0.1:9400
CANVAS_OIDC_JWKS_URL=http://idp:9400/jwks.json
CANVAS_OIDC_CLIENT_ID=felix-canvas
CANVAS_OIDC_SCOPES=openid profile
CANVAS_OIDC_SUBJECT_CLAIM=sub

# Rooms and who may open each, as room=member,member separated by spaces. A
# member is a value of CANVAS_OIDC_SUBJECT_CLAIM, or group:<name> with
# CANVAS_OIDC_GROUPS_CLAIM set.
CANVAS_ROOMS=lobby=ana,ben studio=ana
